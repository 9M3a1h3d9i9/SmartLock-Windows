<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0A0E13" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121821" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#263241" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA7B5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#071018" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="CredentialBoxStyle" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
