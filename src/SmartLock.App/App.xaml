<Application x:Class="SmartLock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA4B2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    </Application.Resources>
</Application>
