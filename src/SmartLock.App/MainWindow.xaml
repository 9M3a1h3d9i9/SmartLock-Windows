<Window x:Class="SmartLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLock"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SMARTLOCK" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Security incident engine" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="DEVELOPMENT MODE" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1" MaxWidth="1120" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,56,0">
                <TextBlock Text="Protected session" FontSize="42" FontWeight="SemiBold" />
                <TextBlock Text="SmartLock records authentication incidents and enforces an application-level lockout policy."
                           TextWrapping="Wrap" MaxWidth="540" FontSize="17" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,0" />

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="SECURITY POLICY" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="5 failed attempts → 30-second application lockout" FontSize="14" Margin="0,8,0,0" />
                        <TextBlock Text="Windows credentials are never collected or intercepted in this development build."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding LockoutMessage}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="INCIDENT TIMELINE" FontSize="11" FontWeight="Bold" Margin="0,24,0,8" />
                <ListBox ItemsSource="{Binding IncidentTimeline}" MaxHeight="190" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding EventType}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="24" Padding="32">
                <StackPanel>
                    <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Development authentication • no Windows password access"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,22" />
                    <PasswordBox x:Name="PinBox" Style="{StaticResource CredentialBoxStyle}" />
                    <Button Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Height="46" Margin="0,14,0,0" Click="Unlock_Click" IsEnabled="{Binding CanSubmit}" />

                    <CheckBox Content="Capture a camera photo after a failed attempt"
                              IsChecked="{Binding CameraEvidenceEnabled, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              FontSize="13" />
                    <TextBlock Text="Opt-in only. Evidence is captured from the default webcam and stored locally. Camera privacy settings still apply."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               Margin="24,6,0,0" />
                    <CheckBox Content="Lock Windows session after policy lockout"
                              IsChecked="{Binding LockWindowsSessionOnPolicyLockout, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              FontSize="13" />
                    <TextBlock Text="Optional. Uses the official Windows workstation lock API; it does not read or manage your Windows password."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               Margin="24,6,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Left" Text="MahdiCS313 • SmartLock-Windows" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock DockPanel.Dock="Right" Text="Ctrl+E • Exit development shell" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>
