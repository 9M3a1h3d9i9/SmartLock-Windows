<Window x:Class="SmartLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLock"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SMARTLOCK" FontSize="14" FontWeight="Bold" LetterSpacing="2" />
                <TextBlock Text="Secure session" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="DEVELOPMENT MODE" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1" MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,72,0">
                <TextBlock Text="Welcome back" FontSize="46" FontWeight="SemiBold" />
                <TextBlock Text="Your session is protected by SmartLock." FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,0" />
                <TextBlock Text="This development build demonstrates the authentication experience without intercepting Windows credentials." TextWrapping="Wrap" MaxWidth="540" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,18,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="24" Padding="32">
                <StackPanel>
                    <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Enter your development credential" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,22" />
                    <PasswordBox x:Name="PinBox" Style="{StaticResource CredentialBoxStyle}" />
                    <Button Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Height="46" Margin="0,14,0,0" Click="Unlock_Click" />
                    <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Left" Text="MahdiCS313 • SmartLock-Windows" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock DockPanel.Dock="Right" Text="Ctrl+E  •  Exit development shell" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>
