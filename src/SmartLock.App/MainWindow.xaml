<Window x:Class="SmartLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLock"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <TextBlock Text="SmartLock" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Secure session • Intelligent protection" Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,32" />
            <PasswordBox x:Name="PinBox" Height="48" FontSize="20" Padding="14,8" />
            <Button Content="Unlock" Height="46" Margin="0,12,0,0" Click="Unlock_Click" />
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="MahdiCS313 • SmartLock-Windows" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
    </Grid>
</Window>
